# ─── Application ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-here

# ─── Database ───────────────────────────────────────────────────
POSTGRES_USER=wb_user
POSTGRES_PASSWORD=wb_password
POSTGRES_DB=wb_cabinet
DATABASE_URL="postgresql://wb_user:wb_password@localhost:5432/wb_cabinet?schema=public"

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Scheduled jobs may wait behind long-running account jobs. Keep this below 1440 minutes.
SCHEDULED_START_GRACE_MINUTES=1080

# ─── Google Sheets ───────────────────────────────────────────────
# Base64 encoded service-account JSON. Share target spreadsheets with the service-account email.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-encoded-service-account-json

# ─── Encryption ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting WB API keys (must be exactly 32 bytes, hex-encoded = 64 chars)
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here-replace-this-value-now

# ─── First Admin (used by seed script) ──────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator
