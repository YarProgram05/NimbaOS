# Copy to .env.production on the VPS and replace every placeholder.
# Do not commit real secrets.

NEXTAUTH_URL=https://nimba.example.com
NEXTAUTH_SECRET=replace-with-a-random-32-plus-character-secret

POSTGRES_USER=nimba
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nimbaos

# The app containers override DATABASE_URL to use the internal postgres host.
# Keep this value for local admin commands that read .env.production directly.
DATABASE_URL=postgresql://nimba:replace-with-a-strong-password@postgres:5432/nimbaos?schema=public

REDIS_URL=redis://redis:6379

# Allows daily jobs to wait behind long-running jobs without overlapping the next daily cycle.
SCHEDULED_START_GRACE_MINUTES=1080

# AES-256-GCM key for encrypted WB API keys: 64 hex chars.
ENCRYPTION_KEY=replace-with-64-hex-characters

# Base64-encoded Google service account JSON used by scheduled automations.
# Keep the real value only in .env.production; never commit it.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-encoded-service-account-json

# Used only when running npm run db:seed intentionally.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator
